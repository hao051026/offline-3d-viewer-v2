# 统一行尾，避免跨平台协作时产生无意义 diff
* text=auto

# 源码与文档用 LF
*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Windows 专用脚本用 CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.wasm  binary
*.glb   binary
*.b3dm  binary
